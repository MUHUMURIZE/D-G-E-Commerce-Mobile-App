NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://dg_user:change_this_password@localhost:5432/dg_ecommerce
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PASSWORD_RESET_URL=http://localhost:8081/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Optional SMTP configuration. Password reset returns a generic response when
# mail is not configured; configure all SMTP values to enable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=D&G <no-reply@example.rw>
